JWT_KEY=
ONNX_MODEL_PATH=
ONNXRUNTIME_SHARED_LIBRARY_PATH=
DB_PATH=cuarenta.db

# ISMCTS simulations per AI turn. 0 = use the policy only (one forward pass, argmax).
# The served network is a policy: ~49% against the heuristic alone, ~77% with the search.
# Measured vs the heuristic: 0 sims 49%, 32 -> 57%, 64 -> 59%, 128 -> 72%, 400 -> 77%.
AI_SEARCH_ITERATIONS=128
AI_SEARCH_CPUCT=1.5
