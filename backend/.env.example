JWT_KEY=
ONNX_MODEL_PATH=
ONNXRUNTIME_SHARED_LIBRARY_PATH=
DB_PATH=cuarenta.db

# ISMCTS simulations per AI turn. 0 = use the policy only (one forward pass, argmax).
# The served network is a policy: ~49% against the heuristic alone, ~77% with the search.
# Measured vs the heuristic: 0 sims 49%, 32 -> 57%, 64 -> 59%, 128 -> 72%, 400 -> 77%.
AI_SEARCH_ITERATIONS=128
AI_SEARCH_CPUCT=1.5
# How long the first AI move of a deal is held back, so the deal animation has finished before a
# card flies across the board. Match it to the web UI: DEAL_TOTAL_MS + DEAL_HOLD_MS in
# web-ui/src/lib/GameBoard.svelte (5540 + 1000 at HAND_DEAL_MS=250, HAND_GAP_MS=180). 0 = no wait.
AI_DEAL_GRACE_MS=3000
# Admin dashboard (/dashboard in the web UI). CHANGE THE PASSWORD: this file is local and not in
# git, but the default is a default. An empty ADMIN_PASSWORD keeps the dashboard closed.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Where the game statistics live (the dashboard reads this file; it is separate from the game DB).
STATS_DB_PATH="statistics.db"
